# ── Brand ──────────────────────────────────────────────
BRAND_NAME="FZ-craft"
NEXT_PUBLIC_BRAND_NAME="FZ-craft"
KEY_PREFIX="fz_live_"

# ── URLs / ports ───────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000          # public web URL (also serves /v1 via rewrite); production: https://fzcraft.pikonox.com
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000 # where Next.js forwards /api and /v1
# Public OpenAI-compatible base URL shown to users in docs, snippets and the dashboard
PUBLIC_API_BASE_URL=https://fzcraft.pikonox.com/v1

# ── Database ───────────────────────────────────────────
# Local Docker (pnpm db:up):
MONGODB_URI="mongodb://localhost:27017/nova?replicaSet=rs0&directConnection=true"
# MongoDB Atlas: mongodb+srv://USER:PASSWORD@your-cluster.xxxxx.mongodb.net/fzcraft?retryWrites=true&w=majority

# ── Secrets (generate with: openssl rand -hex 32) ──────
SESSION_SECRET=change-me
ENCRYPTION_KEY=change-me-64-hex-chars

# ── Seed admin ─────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# ── Google sign-in (optional) ──────────────────────────
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Email (optional; OTPs print to console if empty) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FZ-craft <no-reply@fzcraft.pikonox.com>"

# ── Telegram verification bot (optional) ───────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Payments ───────────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_BEP20_ADDRESS=
BSC_MIN_CONFIRMATIONS=5
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Playground web search (optional, Tavily) ───────────
SEARCH_API_KEY=

# ── File storage ───────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Cloudinary (set STORAGE_DRIVER=cloudinary). Copy "API environment variable" from Cloudinary → Settings → API Keys
CLOUDINARY_URL=
CLOUDINARY_FOLDER=fz-craft
# Generated images (Image Studio + /v1/images) are deleted from storage and history after this many hours
IMAGE_RETENTION_HOURS=48

# ── Dev ────────────────────────────────────────────────
ENABLE_MOCK_PROVIDER=true

# ── Legal pages (/legal/*) ─────────────────────────────
# Shown in the Terms, Privacy Policy and other policies. Use your registered business name if you have one.
LEGAL_ENTITY="FZ-craft"
LEGAL_COUNTRY="Pakistan"
LEGAL_EMAIL="support@fzcraft.pikonox.com"

# ── Your AI provider (OpenAI-compatible) ───────────────
# `pnpm seed` creates this provider and routes EVERY model to it with the same model id.
# Base URL usually ends in /v1, e.g. https://api.your-provider.com/v1
UPSTREAM_NAME="Main provider"
UPSTREAM_BASE_URL=
# One key, or several separated by commas (requests are load-balanced and fail over between them)
UPSTREAM_API_KEYS=

# ── Free-tier provider: serves the free models (FREE_MODELS in apps/api/src/scripts/catalog.ts) ──
# Comma-separate several keys to spread load. Run `SYNC_MODELS=1 pnpm seed` after changing these.
FREE_UPSTREAM_NAME="Duoroute"
FREE_UPSTREAM_BASE_URL=https://api.elisart.ru/v1
FREE_UPSTREAM_API_KEYS=


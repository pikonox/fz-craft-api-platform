    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nova/shared": "workspace:*",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.1",
    "gpt-tokenizer": "^2.9.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.24.0",
    "multer": "^2.0.0",
    "node-cron": "^4.0.0",
    "nodemailer": "^7.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "telegraf": "^4.16.3",
    "unpdf": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
